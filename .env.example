# Copy to .env and fill in. See docs/google-sheet-setup.md.
#
# Google Apps Script web app URL that appends demo requests to the sheet.
# Read server-side only — never prefix this with VITE_, which would publish it
# in the browser bundle.
DEMO_WEBHOOK_URL=

# Optional CDN origin for the 7.4 MB landscape hero master, e.g.
# https://cdn.example.com (no trailing slash). Leave unset to serve it from the
# app's own /assets bundle, which is what local dev does.
#
# Worth setting only if the host serves real HTTP 206 range responses — Railway
# answers a Range request with the whole file and a 200, so the browser can't
# seek and has to download all 7.4 MB before the hero scrubs smoothly. Verify
# with:  curl -sI -H 'Range: bytes=0-1' <base>/hero-desktop.mp4
#
# Unlike DEMO_WEBHOOK_URL this IS a VITE_ var: it's a public asset URL that has
# to reach the browser, so it is deliberately part of the client bundle.
VITE_MEDIA_BASE=
